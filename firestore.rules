rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'pro' ||
         request.auth.token.email == "dsdm0012@gmail.com");
    }

    // Users
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Bots
    match /bots/{botId} {
      // Anyone can read bot config (for the widget)
      allow read: if true;
      // Only owner or admin can create/update/delete
      allow create: if isAuthenticated() && (request.resource.data.get('userId', null) == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.get('userId', null) == request.auth.uid || isAdmin());

      // Knowledge Base Chunks
      match /knowledge/{chunkId} {
        // Anyone can read (for the bot to use it)
        allow read: if true;
        // Only bot owner or admin can manage
        allow create, update, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/bots/$(botId)).data.get('userId', null) == request.auth.uid || 
          isAdmin()
        );
      }

      // Presence (Collaboration)
      match /presence/{userId} {
        // Anyone can read/write presence for now to fix collaboration issues
        allow read, write: if true;
      }

      // Sessions
      match /sessions/{sessionId} {
        // Anyone can read/write sessions and messages for the widget
        allow read, write: if true;
        
        match /messages/{messageId} {
          allow read, write: if true;
        }
      }
    }
  }
}
